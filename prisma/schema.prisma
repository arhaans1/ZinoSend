generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Multi-tenant organizations (each client is an organization)
model Organization {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique

  // WhatsApp Business Account
  wabaId            String?  @map("waba_id")
  phoneNumber       String?  @map("phone_number")
  phoneNumberId     String?  @map("phone_number_id")
  gupshupAppId      String?  @map("gupshup_app_id")
  gupshupApiKey     String?  @map("gupshup_api_key")

  // Billing
  walletBalance     Decimal  @default(0) @map("wallet_balance") @db.Decimal(10, 2)
  subscriptionPlan  SubscriptionPlan @default(FREE) @map("subscription_plan")
  subscriptionEndsAt DateTime? @map("subscription_ends_at")
  razorpayCustomerId String? @map("razorpay_customer_id")

  // GoHighLevel Integration
  ghlLocationId     String?  @map("ghl_location_id")
  ghlAccessToken    String?  @map("ghl_access_token")
  ghlRefreshToken   String?  @map("ghl_refresh_token")
  ghlTokenExpiresAt DateTime? @map("ghl_token_expires_at")

  // Settings
  timezone          String   @default("Asia/Kolkata")
  webhookSecret     String?  @map("webhook_secret")

  // Timestamps
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  users             User[]
  contacts          Contact[]
  templates         Template[]
  broadcasts        Broadcast[]
  messages          Message[]
  conversations     Conversation[]
  transactions      Transaction[]

  @@map("organizations")
}

enum SubscriptionPlan {
  FREE
  STARTER
  GROWTH
  ENTERPRISE
}

// Users belong to an organization
model User {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")

  email           String   @unique
  passwordHash    String   @map("password_hash")
  name            String
  avatarUrl       String?  @map("avatar_url")

  role            UserRole @default(AGENT)
  permissions     Json     @default("{}")

  emailVerified   DateTime? @map("email_verified")
  lastLoginAt     DateTime? @map("last_login_at")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBroadcasts Broadcast[] @relation("CreatedBy")
  assignedConversations Conversation[]

  @@map("users")
}

enum UserRole {
  OWNER
  ADMIN
  AGENT
}

// WhatsApp contacts
model Contact {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")

  phone           String   // With country code, e.g., +919876543210
  name            String?
  email           String?

  tags            String[] @default([])
  attributes      Json     @default("{}") // Custom key-value pairs

  source          ContactSource @default(MANUAL)
  ghlContactId    String?  @map("ghl_contact_id")

  optedIn         Boolean  @default(true) @map("opted_in")
  optedInAt       DateTime? @map("opted_in_at")

  lastMessageAt   DateTime? @map("last_message_at")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages        Message[]
  conversations   Conversation[]
  broadcastRecipients BroadcastRecipient[]

  @@unique([organizationId, phone])
  @@index([organizationId, tags])
  @@map("contacts")
}

enum ContactSource {
  MANUAL
  IMPORT
  GHL
  WHATSAPP
  API
}

// WhatsApp message templates
model Template {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")

  name            String   // Internal name
  templateName    String   @map("template_name") // Name submitted to Meta (lowercase, underscores)

  category        TemplateCategory
  language        String   @default("en")

  // Template components
  headerType      HeaderType? @map("header_type")
  headerContent   String?  @map("header_content") // Text or media URL
  body            String   // Message body with {{1}}, {{2}} variables
  footer          String?
  buttons         Json?    // Array of button objects

  // Meta approval status
  status          TemplateStatus @default(DRAFT)
  metaTemplateId  String?  @map("meta_template_id")
  rejectionReason String?  @map("rejection_reason")

  // Stats
  timesUsed       Int      @default(0) @map("times_used")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  broadcasts      Broadcast[]
  messages        Message[]

  @@unique([organizationId, templateName, language])
  @@map("templates")
}

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum HeaderType {
  TEXT
  IMAGE
  VIDEO
  DOCUMENT
}

enum TemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

// Broadcast campaigns
model Broadcast {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  templateId      String   @map("template_id")
  createdById     String   @map("created_by_id")

  name            String

  // Variable mapping: { "1": "name", "2": "static:Hello" }
  variableMapping Json     @default("{}") @map("variable_mapping")

  // Scheduling
  status          BroadcastStatus @default(DRAFT)
  scheduledAt     DateTime? @map("scheduled_at")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")

  // Stats (denormalized for quick access)
  totalRecipients Int      @default(0) @map("total_recipients")
  sentCount       Int      @default(0) @map("sent_count")
  deliveredCount  Int      @default(0) @map("delivered_count")
  readCount       Int      @default(0) @map("read_count")
  failedCount     Int      @default(0) @map("failed_count")

  // Cost tracking
  totalCost       Decimal  @default(0) @map("total_cost") @db.Decimal(10, 2)

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template        Template @relation(fields: [templateId], references: [id])
  createdBy       User     @relation("CreatedBy", fields: [createdById], references: [id])
  recipients      BroadcastRecipient[]
  messages        Message[]

  @@map("broadcasts")
}

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  PROCESSING
  COMPLETED
  CANCELLED
  FAILED
}

// Many-to-many for broadcast recipients
model BroadcastRecipient {
  id              String   @id @default(cuid())
  broadcastId     String   @map("broadcast_id")
  contactId       String   @map("contact_id")

  status          MessageStatus @default(QUEUED)

  // Relations
  broadcast       Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contact         Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, contactId])
  @@map("broadcast_recipients")
}

// Individual messages
model Message {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  contactId       String   @map("contact_id")
  conversationId  String   @map("conversation_id")
  broadcastId     String?  @map("broadcast_id")
  templateId      String?  @map("template_id")

  direction       MessageDirection
  type            MessageType

  // Content varies by type
  content         Json     // { text: "", mediaUrl: "", caption: "", etc. }

  // Status tracking
  status          MessageStatus @default(QUEUED)
  gupshupMsgId    String?  @map("gupshup_msg_id")
  errorMessage    String?  @map("error_message")

  // Cost (for outbound)
  cost            Decimal  @default(0) @db.Decimal(10, 4)

  // Timestamps
  sentAt          DateTime? @map("sent_at")
  deliveredAt     DateTime? @map("delivered_at")
  readAt          DateTime? @map("read_at")
  failedAt        DateTime? @map("failed_at")

  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact         Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  broadcast       Broadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)
  template        Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([conversationId, createdAt])
  @@index([gupshupMsgId])
  @@map("messages")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
  STICKER
  TEMPLATE
  INTERACTIVE
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

// Conversations (thread with a contact)
model Conversation {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  contactId       String   @map("contact_id")

  // 24-hour session window
  sessionExpiresAt DateTime? @map("session_expires_at")

  // Assignment
  assignedToId    String?  @map("assigned_to_id")

  // Status
  status          ConversationStatus @default(OPEN)
  unreadCount     Int      @default(0) @map("unread_count")

  lastMessageAt   DateTime? @map("last_message_at")
  lastMessagePreview String? @map("last_message_preview")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact         Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedTo      User?    @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  messages        Message[]

  @@unique([organizationId, contactId])
  @@index([organizationId, lastMessageAt])
  @@map("conversations")
}

enum ConversationStatus {
  OPEN
  CLOSED
  RESOLVED
}

// Billing transactions
model Transaction {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")

  type            TransactionType
  amount          Decimal  @db.Decimal(10, 2)
  balanceAfter    Decimal  @map("balance_after") @db.Decimal(10, 2)

  description     String

  // Payment references
  razorpayPaymentId String? @map("razorpay_payment_id")
  razorpayOrderId   String? @map("razorpay_order_id")

  // For message deductions
  broadcastId     String?  @map("broadcast_id")
  messageCount    Int?     @map("message_count")

  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("transactions")
}

enum TransactionType {
  TOPUP
  DEDUCTION
  REFUND
  SUBSCRIPTION
}
