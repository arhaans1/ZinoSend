generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Multi-tenant organizations (each client is an organization)
model Organization {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique

  // WhatsApp Business Account
  wabaId            String?  @map("waba_id")
  phoneNumber       String?  @map("phone_number")
  phoneNumberId     String?  @map("phone_number_id")
  gupshupAppId      String?  @map("gupshup_app_id")
  gupshupApiKey     String?  @map("gupshup_api_key")

  // Billing
  walletBalance     Decimal  @default(0) @map("wallet_balance")
  subscriptionPlan  String   @default("FREE") @map("subscription_plan")
  subscriptionEndsAt DateTime? @map("subscription_ends_at")
  razorpayCustomerId String? @map("razorpay_customer_id")

  // GoHighLevel Integration
  ghlLocationId     String?  @map("ghl_location_id")
  ghlAccessToken    String?  @map("ghl_access_token")
  ghlRefreshToken   String?  @map("ghl_refresh_token")
  ghlTokenExpiresAt DateTime? @map("ghl_token_expires_at")

  // Settings
  timezone          String   @default("Asia/Kolkata")
  webhookSecret     String?  @map("webhook_secret")

  // Timestamps
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  users             User[]
  contacts          Contact[]
  templates         Template[]
  broadcasts        Broadcast[]
  messages          Message[]
  conversations     Conversation[]
  transactions      Transaction[]

  @@map("organizations")
}

// Users belong to an organization
model User {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")

  email           String   @unique
  passwordHash    String   @map("password_hash")
  name            String
  avatarUrl       String?  @map("avatar_url")

  role            String   @default("AGENT")
  permissions     String   @default("{}")

  emailVerified   DateTime? @map("email_verified")
  lastLoginAt     DateTime? @map("last_login_at")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBroadcasts Broadcast[] @relation("CreatedBy")
  assignedConversations Conversation[]

  @@map("users")
}

// WhatsApp contacts
model Contact {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")

  phone           String   // With country code, e.g., +919876543210
  name            String?
  email           String?

  tags            String   @default("[]") // JSON array as string
  attributes      String   @default("{}") // JSON object as string

  source          String   @default("MANUAL")
  ghlContactId    String?  @map("ghl_contact_id")

  optedIn         Boolean  @default(true) @map("opted_in")
  optedInAt       DateTime? @map("opted_in_at")

  lastMessageAt   DateTime? @map("last_message_at")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages        Message[]
  conversations   Conversation[]
  broadcastRecipients BroadcastRecipient[]

  @@unique([organizationId, phone])
  @@map("contacts")
}

// WhatsApp message templates
model Template {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")

  name            String   // Internal name
  templateName    String   @map("template_name") // Name submitted to Meta

  category        String   // MARKETING, UTILITY, AUTHENTICATION
  language        String   @default("en")

  // Template components
  headerType      String?  @map("header_type") // TEXT, IMAGE, VIDEO, DOCUMENT
  headerContent   String?  @map("header_content")
  body            String
  footer          String?
  buttons         String?  // JSON array

  // Meta approval status
  status          String   @default("DRAFT") // DRAFT, PENDING, APPROVED, REJECTED
  metaTemplateId  String?  @map("meta_template_id")
  rejectionReason String?  @map("rejection_reason")

  // Stats
  timesUsed       Int      @default(0) @map("times_used")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  broadcasts      Broadcast[]
  messages        Message[]

  @@unique([organizationId, templateName, language])
  @@map("templates")
}

// Broadcast campaigns
model Broadcast {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  templateId      String   @map("template_id")
  createdById     String   @map("created_by_id")

  name            String

  variableMapping String   @default("{}") @map("variable_mapping")

  // Scheduling
  status          String   @default("DRAFT") // DRAFT, SCHEDULED, PROCESSING, COMPLETED, CANCELLED, FAILED
  scheduledAt     DateTime? @map("scheduled_at")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")

  // Stats
  totalRecipients Int      @default(0) @map("total_recipients")
  sentCount       Int      @default(0) @map("sent_count")
  deliveredCount  Int      @default(0) @map("delivered_count")
  readCount       Int      @default(0) @map("read_count")
  failedCount     Int      @default(0) @map("failed_count")

  // Cost tracking
  totalCost       Decimal  @default(0) @map("total_cost")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template        Template @relation(fields: [templateId], references: [id])
  createdBy       User     @relation("CreatedBy", fields: [createdById], references: [id])
  recipients      BroadcastRecipient[]
  messages        Message[]

  @@map("broadcasts")
}

// Many-to-many for broadcast recipients
model BroadcastRecipient {
  id              String   @id @default(cuid())
  broadcastId     String   @map("broadcast_id")
  contactId       String   @map("contact_id")

  status          String   @default("QUEUED") // QUEUED, SENT, DELIVERED, READ, FAILED

  // Relations
  broadcast       Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contact         Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, contactId])
  @@map("broadcast_recipients")
}

// Individual messages
model Message {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  contactId       String   @map("contact_id")
  conversationId  String   @map("conversation_id")
  broadcastId     String?  @map("broadcast_id")
  templateId      String?  @map("template_id")

  direction       String   // INBOUND, OUTBOUND
  type            String   // TEXT, IMAGE, VIDEO, DOCUMENT, AUDIO, STICKER, TEMPLATE, INTERACTIVE

  content         String   // JSON object

  // Status tracking
  status          String   @default("QUEUED") // QUEUED, SENT, DELIVERED, READ, FAILED
  gupshupMsgId    String?  @map("gupshup_msg_id")
  errorMessage    String?  @map("error_message")

  // Cost
  cost            Decimal  @default(0)

  // Timestamps
  sentAt          DateTime? @map("sent_at")
  deliveredAt     DateTime? @map("delivered_at")
  readAt          DateTime? @map("read_at")
  failedAt        DateTime? @map("failed_at")

  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact         Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  broadcast       Broadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)
  template        Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([conversationId, createdAt])
  @@index([gupshupMsgId])
  @@map("messages")
}

// Conversations (thread with a contact)
model Conversation {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  contactId       String   @map("contact_id")

  // 24-hour session window
  sessionExpiresAt DateTime? @map("session_expires_at")

  // Assignment
  assignedToId    String?  @map("assigned_to_id")

  // Status
  status          String   @default("OPEN") // OPEN, CLOSED, RESOLVED
  unreadCount     Int      @default(0) @map("unread_count")

  lastMessageAt   DateTime? @map("last_message_at")
  lastMessagePreview String? @map("last_message_preview")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact         Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedTo      User?    @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  messages        Message[]

  @@unique([organizationId, contactId])
  @@index([organizationId, lastMessageAt])
  @@map("conversations")
}

// Billing transactions
model Transaction {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")

  type            String   // TOPUP, DEDUCTION, REFUND, SUBSCRIPTION
  amount          Decimal
  balanceAfter    Decimal  @map("balance_after")

  description     String

  // Payment references
  razorpayPaymentId String? @map("razorpay_payment_id")
  razorpayOrderId   String? @map("razorpay_order_id")

  // For message deductions
  broadcastId     String?  @map("broadcast_id")
  messageCount    Int?     @map("message_count")

  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("transactions")
}

// Super Admin (Platform Admin - sits above all organizations)
model SuperAdmin {
  id              String   @id @default(cuid())

  email           String   @unique
  passwordHash    String   @map("password_hash")
  name            String

  isActive        Boolean  @default(true) @map("is_active")
  lastLoginAt     DateTime? @map("last_login_at")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("super_admins")
}
